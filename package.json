{
  "name": "codex-deck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify:m0-01": "node --experimental-strip-types --test tests/m0/*.test.ts",
    "verify:m0-02": "node --experimental-strip-types --test tests/m0/thread.test.ts tests/m0/cli-bridge.test.ts",
    "verify:m0-03": "node --experimental-strip-types --test tests/m0/cli-bridge.test.ts tests/m0/live.test.ts",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint src/main src/preload src/shared src/renderer/src tests/m1 e2e electron.vite.config.ts playwright.config.ts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run build && playwright test",
    "verify:m1-01": "npm run test:e2e",
    "rebuild:source": "electron-rebuild -f -w better-sqlite3,node-pty",
    "setup:windows": "npm ci --ignore-scripts && node node_modules/electron/install.js && node node_modules/node-pty/scripts/post-install.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "playwright": "^1.61.1",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
